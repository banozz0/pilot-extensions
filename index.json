    {
      "id": "ai-usage",
      "title": "AI usage",
      "icon": "📊",
      "version": "2.0.0",
      "description": "See how much of your Claude and Codex limits you have used this session and this week, and when each resets, in the menu bar.",
      "examples": [
        "Glance at the menu bar: C and X gauges, the session over the week, amber from 60% and red from 85%",
        "Click the gauges: a card per provider with Claude's session and week, Codex's 5 hours, week and credits, and when each was read"
      ],
      "requires": [
        "python3"
      ],
      "commands": [
        {
          "name": "usage",
          "title": "AI usage",
          "mode": "detail"
        },
        {
          "name": "summary",
          "title": "AI usage summary",
          "mode": "no-view"
        }
      ],
      "permissions": {
        "network": [],
        "clipboard": true,

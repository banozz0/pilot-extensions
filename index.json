{
  "schema": 1,
  "extensions": [
    {
      "id": "pomodoro",
      "title": "Pomodoro",
      "icon": "🍅",
      "version": "1.0.0",
      "description": "Focus blocks and breaks, counted down in the menu bar, with the long break every few blocks.",
      "requires": [
        "python3"
      ],
      "commands": [
        {
          "name": "focus",
          "title": "Focus",
          "mode": "no-view"
        },
        {
          "name": "break",
          "title": "Break",
          "mode": "no-view"
        },
        {
          "name": "custom",
          "title": "Custom focus…",
          "mode": "list"
        },
        {
          "name": "pause",
          "title": "Pause timer",
          "mode": "no-view"
        },
        {
          "name": "resume",
          "title": "Resume timer",
          "mode": "no-view"
        },
        {
          "name": "skip",
          "title": "Skip block",

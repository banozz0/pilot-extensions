    {
      "id": "ai-usage",
      "title": "AI usage",
      "icon": "📊",
      "version": "3.3.0",
      "description": "See how much of your Claude and Codex limits is left this session and this week, how your pace compares, and when each resets, in the menu bar, as CodexBar shows it. Add a second Codex account with Codex's own sign-in.",
      "examples": [
        "Glance at the menu bar: Claude's and Codex's logo with the session left, amber once a window is 60% used, red from 85%",
        "Click it: a card per provider and Codex account with its plan, each window's share left draining, its pace tick (red in deficit) and its reset, the pace in words on hover; Claude's per-model week, Codex's limit reset credits, and one row with each status page, the usage dashboards and Add Codex account"
      ],
      "requires": [
        "python3"
      ],
      "commands": [
        {
          "name": "usage",
          "title": "AI usage",
          "mode": "detail"
        },
        {
          "name": "add-account",
          "title": "Add Codex account",
          "mode": "no-view"
        },
        {
          "name": "summary",
          "title": "AI usage summary",
          "mode": "no-view"
        }
      ],
      "permissions": {
        "network": [
          "status.claude.com",
          "status.openai.com"
        ],
        "clipboard": true,
        "files": [
          "~/.local/state/ghostex/agent-hooks/claude-statusline",
          "~/.claude.json",
          "~/.codex/sessions",
          "~/.codex/archived_sessions",
          "~/.claude/projects"
        ],
        "actions": []
